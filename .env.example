# ──────────────────────────────────────────────────────────────────────────────
# Clubmate AI — Environment Configuration
# Copy this file to .env and fill in your values.
# The dashboard UI can also write these values for you after initial setup.
# ──────────────────────────────────────────────────────────────────────────────

# ── Discord ───────────────────────────────────────────────────────────────────
# Get from https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# Discord role name that grants exec/admin access to bot commands
EXEC_ROLE_NAME=Executive

# ── Gemini ────────────────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model to use for chat and RAG generation
DEFAULT_LLM_MODEL=gemini-2.5-flash

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Set up via the dashboard — Google account connection page handles OAuth flow
# Get from https://console.cloud.google.com/ > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Paths to OAuth token files (written automatically after OAuth flow)
GOOGLE_TOKEN_PATH=./data/google_token.json
GOOGLE_CREDENTIALS_PATH=./data/google_credentials.json

# ── RAG ───────────────────────────────────────────────────────────────────────
CHROMA_DB_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=clubmate-docs
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
TOP_K_RESULTS=5
TEMPERATURE=0.7
CHUNK_THRESHOLD_TYPE=percentile
CHUNK_THRESHOLD_AMOUNT=95.0

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=change-me-in-production

# ── Meeting Transcription ─────────────────────────────────────────────────────
# Discord channel ID where meeting summaries are posted after a session ends
MEETING_SUMMARY_CHANNEL_ID=

# "local" uses local Whisper model (free, runs on your server)
# "api" uses OpenAI Whisper API (requires OPENAI_API_KEY, costs $)
WHISPER_MODE=local
OPENAI_API_KEY=

# ============================================================================
# Clubmate-AI - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED CONFIGURATION
# ----------------------------------------------------------------------------

# Discord Bot Token (Required for Discord bot)
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-token-here

# Gemini API Key (Required)
# Get your API key from: https://makersuite.google.com/app/apikey
# Used by Gemini MCP Client and RAG system
GEMINI_API_KEY=your-gemini-api-key-here

# Google OAuth (Required for Calendar integration)
# credentials.json and token.json should be in the root directory
# Run: python src/authenticate.py to generate token.json


# ----------------------------------------------------------------------------
# RAG CONFIGURATION (Optional)
# ----------------------------------------------------------------------------

# ChromaDB Settings
# -----------------
# Directory where the vector database will be stored
# Default: ragbot/chroma_db
# CHROMA_DB_DIR=./chroma_db

# Name of the ChromaDB collection for storing document embeddings
# Default: rag-documents
# CHROMA_COLLECTION_NAME=rag-documents

# Embedding Model Settings
# -------------------------
# Embedding model for creating document embeddings (via langchain_huggingface)
# Default: BAAI/bge-base-en-v1.5 (768 dimensions, good balance of speed/quality)
# 
# Other options:
# - all-MiniLM-L6-v2 (384 dimensions, faster but less accurate)
# - BAAI/bge-large-en-v1.5 (1024 dimensions, slower but more accurate)
# - sentence-transformers/all-mpnet-base-v2 (768 dimensions)
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5


# ----------------------------------------------------------------------------
# LLM CONFIGURATION (Optional)
# ----------------------------------------------------------------------------

# Default Google Gemini model to use for answer generation
# Default: gemini-2.5-flash-lite
#
# Other options:
# - gemini-2.0-flash (fast, production-ready)
# - gemini-2.0-flash-exp (experimental, fast)
# - gemini-1.5-pro (more powerful, slower)
# - gemini-1.5-flash (balanced)
# DEFAULT_LLM_MODEL=gemini-2.5-flash-lite


# ----------------------------------------------------------------------------
# RAG PARAMETERS (Optional)
# ----------------------------------------------------------------------------

# Number of document chunks to retrieve for each query
# Default: 5
# TOP_K_RESULTS=5

# LLM temperature (0.0 = deterministic, 1.0 = creative)
# Default: 0.7
# TEMPERATURE=0.7

# Semantic chunking threshold type
# Options: percentile, standard_deviation, interquartile
# Default: percentile
# CHUNK_THRESHOLD_TYPE=percentile

# Semantic chunking threshold amount
# For percentile: 0-100 (higher = fewer, larger chunks)
# Default: 95.0
# CHUNK_THRESHOLD_AMOUNT=95.0
